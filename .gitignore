.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
# PyInstaller writes a .spec beside the script when invoked without one; the
# project's own spec lives in packaging/ and must stay in version control - it
# *is* the packaging configuration.
/*.spec
!packaging/*.spec
.idea/
.vscode/
.DS_Store
*.log
