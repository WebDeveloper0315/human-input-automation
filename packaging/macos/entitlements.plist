<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for a Developer ID signed build.

  Only two entries, and both exist because of how a Python application is
  assembled - not to obtain any additional privilege:

  * disable-library-validation: a PyInstaller bundle loads Python extension
    modules (.so) that are signed with the same identity but are not part of
    the main executable. Without this the hardened runtime refuses to load them.
  * allow-dyld-environment-variables: PyInstaller's bootloader sets
    DYLD_LIBRARY_PATH so the bundled libraries are found.

  Accessibility and Input Monitoring are deliberately NOT listed: macOS grants
  those through System Settings (TCC), not through entitlements, and no
  entitlement can or should bypass them. No camera, microphone, location,
  contacts or file-access entitlements are requested, because the application
  does not use any of them.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
